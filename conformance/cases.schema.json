{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/karammm/flattype/blob/main/conformance/cases.schema.json",
  "title": "Flat Notation conformance cases",
  "description": "conformance/cases.json: generated by @flattype/core. Integers in it can be larger than 2^53 and must be read exactly.",
  "type": "object",
  "required": [
    "encode",
    "decode",
    "refs",
    "bigint"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "The Flat Notation version the cases are for. A file without it is the 1.0 suite.",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "encode": {
      "description": "encode(value, options) must write exactly `text`, and decode(text) must give `value` back.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "value",
          "options",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "value": {},
          "options": {
            "$ref": "#/$defs/encodeOptions"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "decode": {
      "description": "decode(text, options) must give `value` (and, in lenient mode, exactly `warnings`), or fail with `error`.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "options"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "options": {
            "$ref": "#/$defs/decodeOptions"
          },
          "value": {},
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/warning"
            }
          },
          "error": {
            "description": "The reason, then the position: \"Missing value (line 1, column 3)\".",
            "type": "string",
            "pattern": " \\(line \\d+, column \\d+\\)$"
          }
        },
        "oneOf": [
          {
            "required": [
              "value"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ]
      }
    },
    "refs": {
      "description": "decode(text, { refs: true }), then encode(that, { refs: true }), must write exactly `text` again.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          }
        }
      }
    },
    "bigint": {
      "description": "encode(value) must write exactly `text`, and decode(text) must give every integer back exactly.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "value",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "value": {},
          "text": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "encodeOptions": {
      "description": "Missing options take their defaults: delimiter \",\", indent 2, tabular \"auto\", and the file's version as target.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "delimiter": {
          "enum": [
            ",",
            "|",
            "\t"
          ]
        },
        "indent": {
          "type": "integer",
          "minimum": 0
        },
        "tabular": {
          "enum": [
            "auto",
            "off"
          ]
        },
        "target": {
          "description": "Write text for this version (1.1 encoders can write 1.0 text).",
          "enum": [
            "1.0",
            "1.1"
          ]
        }
      }
    },
    "decodeOptions": {
      "description": "Missing options take their defaults: strict true, refs false, skipInvalidLines false.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strict": {
          "type": "boolean"
        },
        "refs": {
          "type": "boolean"
        },
        "skipInvalidLines": {
          "type": "boolean"
        }
      }
    },
    "warning": {
      "type": "object",
      "required": [
        "message",
        "line",
        "column"
      ],
      "additionalProperties": false,
      "properties": {
        "message": {
          "description": "The problem and the repair: \"Missing value: read as null\".",
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
