{
  "name": "@flattype/svelte",
  "version": "1.8.0",
  "description": "Svelte stores (and Solid resources) for FlatType.js: fetch Flat Notation or JSON into typed models, with streaming rows.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js",
      "require": "./dist/solid.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "svelte",
    "svelte5",
    "stores",
    "solid",
    "solidjs",
    "fetch",
    "streaming",
    "models",
    "json",
    "flattype"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run"
  },
  "dependencies": {
    "@flattype/core": "workspace:*",
    "@flattype/http": "workspace:*",
    "@flattype/shared": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karammm/flattype.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/karammm/flattype#readme",
  "bugs": {
    "url": "https://github.com/karammm/flattype/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@flattype/models": "workspace:*",
    "solid-js": "1.9.17",
    "svelte": "5.57.2"
  },
  "peerDependencies": {
    "solid-js": ">=1.7"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    }
  }
}
