{
  "name": "@flattype/vue",
  "version": "1.7.0",
  "description": "Vue 3 composables for FlatType.js: fetch Flat Notation or JSON into typed models, with Suspense and streaming rows.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "vue",
    "vue3",
    "composables",
    "fetch",
    "suspense",
    "streaming",
    "models",
    "json",
    "flattype"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run"
  },
  "dependencies": {
    "@flattype/core": "workspace:*",
    "@flattype/http": "workspace:*",
    "@flattype/shared": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karammm/flattype.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/karammm/flattype#readme",
  "bugs": {
    "url": "https://github.com/karammm/flattype/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@flattype/models": "workspace:*",
    "@vue/test-utils": "2.4.11",
    "jsdom": "25.0.1",
    "vue": "3.5.44"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  }
}
