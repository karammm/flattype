{
  "name": "@flattype/http",
  "version": "1.10.0",
  "description": "Fetch, axios and server helpers that send and receive Flat Notation, with JSON fallback and streaming rows.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "fetch",
    "http",
    "axios",
    "express",
    "fastify",
    "hono",
    "content-negotiation",
    "streaming",
    "json",
    "flattype"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run"
  },
  "dependencies": {
    "@flattype/core": "workspace:*",
    "@flattype/shared": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karammm/flattype.git",
    "directory": "packages/http"
  },
  "homepage": "https://github.com/karammm/flattype#readme",
  "bugs": {
    "url": "https://github.com/karammm/flattype/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@flattype/models": "workspace:*",
    "axios": "1.20.0",
    "express": "5.3.0",
    "@types/express": "5.0.6",
    "fastify": "5.12.7",
    "hono": "4.13.13"
  }
}
