{
  "name": "@flattype/angular",
  "version": "1.13.0",
  "description": "Angular integration for FlatType.js: HttpClient interceptor, signal resources, streaming rows and a model pipe.",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "angular",
    "httpclient",
    "interceptor",
    "signals",
    "pipe",
    "rxjs",
    "streaming",
    "models",
    "json",
    "flattype"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json && node scripts/finalize-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@flattype/core": "workspace:*",
    "@flattype/http": "workspace:*",
    "@flattype/shared": "workspace:*",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": ">=19.0.0",
    "@angular/core": ">=19.0.0",
    "rxjs": "^7.4.0"
  },
  "devDependencies": {
    "@angular/common": "19.2.25",
    "@angular/compiler": "19.2.25",
    "@angular/compiler-cli": "19.2.25",
    "@angular/core": "19.2.25",
    "@angular/platform-browser": "19.2.25",
    "@angular/platform-browser-dynamic": "19.2.25",
    "@flattype/models": "workspace:*",
    "jsdom": "25.0.1",
    "ng-packagr": "19.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.8.3",
    "zone.js": "0.15.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karammm/flattype.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/karammm/flattype#readme",
  "bugs": {
    "url": "https://github.com/karammm/flattype/issues"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "engines": {
    "node": ">=18"
  }
}
