{
  "name": "@flattype/core",
  "version": "1.3.0",
  "description": "Flatten JSON into Flat Notation: compact, LLM-friendly key: value text. No third-party dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "json",
    "flatten",
    "serialization",
    "llm",
    "tokens",
    "claude",
    "toon",
    "api",
    "model",
    "typescript"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run",
    "bench": "vitest bench --run"
  },
  "dependencies": {
    "@flattype/shared": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "^4.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karammm/flattype.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/karammm/flattype#readme",
  "bugs": {
    "url": "https://github.com/karammm/flattype/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
