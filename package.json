{
  "name": "flattype",
  "private": true,
  "description": "FlatType.js — flatten API JSON into compact, LLM-friendly text and map it to typed models",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "bench": "turbo run bench",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "compare": "node scripts/compare.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "release:npm": "turbo run build --filter=./packages/* && node scripts/publish-npm.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@toon-format/toon": "^2.1.0",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "tsup": "^8.3.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
