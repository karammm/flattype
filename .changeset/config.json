{
  "$schema": "https://unpkg.com/@changesets/config@3.0.5/schema.json",
  "changelog": "@changesets/cli/changelog",
  "commit": false,
  "fixed": [
    [
      "@flattype/*"
    ]
  ],
  "linked": [],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": [
    "@flattype/docs",
    "@flattype/example-ai-claude",
    "@flattype/example-angular-app",
    "@flattype/example-node-models",
    "@flattype/example-node-server",
    "@flattype/example-react-app",
    "@flattype/example-solid-app",
    "@flattype/example-svelte-app",
    "@flattype/example-vue-app",
    "@flattype/playground"
  ]
}
